        "domain.ts",
        "getAllowlistIdentifier.ts",
        "getApiKey.ts",
        "getApplication.ts",
        "getApplicationSettings.ts",
        "getBlocklistIdentifier.ts",
        "getDomain.ts",
        "getInstanceConfig.ts",
        "getInstanceDomain.ts",
        "getJwtTemplate.ts",
        "getMachine.ts",
        "getOauthApplication.ts",
        "getOrganization.ts",
        "getOrganizationDomain.ts",
        "getOrganizationMembership.ts",
        "getOrganizationPermission.ts",
        "getOrganizationRole.ts",
        "getRedirectUrl.ts",
        "getRoleSet.ts",
        "getSamlConnection.ts",
        "getSvixWebhook.ts",
        "index.ts",
        "instanceConfig.ts",
        "instanceDomain.ts",
        "jwtTemplate.ts",
        "machine.ts",
        "oauthApplication.ts",
        "organization.ts",
        "organizationDomain.ts",
